$urlSDK = $block->getUrlSDK();
$configUrl = $block->getConfigUrl();
?>
<script src="<?= $block->escapeHtml($urlSDK) ?>"></script>

<div align = "center">
    <input id="back_btn" type="button" onclick="backtoCart()" value="<?= __('Regresar al carrito de compras') ?>" class="action primary checkout"/>
</div>

<br />
<div id="payGetnet-section"></div>

<script type="text/javascript">
require([ 'jquery', 'jquery/ui'], function($){ 
    $(document).ready(function() {
        $.ajax({
            url: '<?= $block->escapeUrl($configUrl) ?>',
            type: 'GET',
            dataType: 'json',
            cache: false
        })
        .done(function(cfg){
            if (cfg.status === 'redirect') {
                window.location.replace(cfg.url);
                return;
            }
            if (cfg.status !== 'init') {
                alert(cfg.message || 'Error al generar la intención de pago');
                window.history.go(-2);
                return;
            }
            loader.init({
                paymentIntentId: cfg.paymentIntentId,
                checkoutType: cfg.checkoutType,
                accessToken: cfg.accessToken
            });
            var iframeSection = document.getElementById("payGetnet-section");
            var iframeGetnet = document.querySelector('iframe[id="digital-checkout-iframe"]');
            if (iframeSection && iframeGetnet) {
                iframeSection.appendChild(iframeGetnet);
            }
        })
        .fail(function(){
            alert('No se pudo generar la intención de pago, por favor intente de nuevo. Si el problema persiste, contacte con un ejecutivo Getnet.');
            window.history.go(-2);
        });
    });
});

    function backtoCart() {
        window.location.replace("<?php echo $block->escapeUrl($block->getURLreturn()) ?>");
    }
 </script>

